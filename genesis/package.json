{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "description": "GENESIS — браузерная живая симуляция цивилизаций",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
