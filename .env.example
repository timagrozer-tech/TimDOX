# Скопируйте этот файл в .env и впишите ключ.
# На Vercel / Render эти же переменные задаются в настройках проекта (Environment Variables).

# ---- OpenRouter — бесплатно (по умолчанию) ----
# Ключ: https://openrouter.ai/settings/keys
# ОБЯЗАТЕЛЬНО включите «Free model publication» на https://openrouter.ai/settings/privacy
OPENROUTER_API_KEY=sk-or-вставьте-сюда-ключ
# Модель: openrouter/free сам выбирает доступную бесплатную модель
# AI_MODEL=openrouter/free
# SITE_URL=https://ваш-сайт.ru

# ---- Или DeepSeek (платно, но очень дёшево) ----
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-вставьте-сюда-ключ

# ---- Необязательные настройки ----
# Код доступа: если задан, ИИ работает только у тех, кто знает код
# ACCESS_CODE=
# Сколько ИИ-запросов в час разрешено с одного IP
RATE_LIMIT_PER_HOUR=30
# Максимальный объём данных в одном запросе (символов)
MAX_INPUT_CHARS=200000
# Максимальная длина ответа (токенов)
MAX_OUTPUT_TOKENS=8000
# Порт для node server.js
PORT=3000
