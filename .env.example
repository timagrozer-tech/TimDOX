# Скопируйте в .env и заполните
APP_NAME=Круг
APP_URL=http://localhost:8000
# В продакшене: https-адрес сайта; cookie будут помечены Secure автоматически
# APP_URL=https://krug.example.ru

# Требовать подтверждение e-mail перед публикацией и перепиской
REQUIRE_EMAIL_CONFIRM=false

# Почта. Если SMTP_HOST пуст — письма пишутся в консоль и в data/outbox.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Круг <no-reply@krug.example.ru>
SMTP_TLS=true

# Где хранить базу и файлы
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
