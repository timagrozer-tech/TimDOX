export const LINKS = [["privacy", "/privacy"], ["terms", "/terms"], ["consent", "/consent"], ["cookies", "/cookies"], ["ai", "/ai-consent"]];

export function legalPage(kind) {
  return async () => {
    const t = DOCS[kind];
    setTitle(t.title);
    const others = LINKS.filter(([k]) => k !== kind).map(([k, href]) => h("a", { href }, DOCS[k].title));
    const body = h("article.card.legal",
      state.me ? null : h("div", { style: { marginBottom: "20px" } }, logo()),
      h("h1", t.title),
      h("p.legal-version", `Редакция от ${new Date(LEGAL_VERSION).toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" })}`),
      t.sections.map(([hd, p]) => [h("h2", hd), h("p", p)]),
      h("nav.legal-other", { "aria-label": "Другие документы" }, h("b", "Другие документы"), ...others));
    return state.me ? body : h("div", { style: { maxWidth: "760px", margin: "0 auto", padding: "24px 16px" } }, body);
  };
}
