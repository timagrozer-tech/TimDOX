.stories-strip { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 2px 6px; }
.stories-strip::-webkit-scrollbar { display: none; }
.story-item { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; width: 76px; flex: none; }
.story-ring { position: relative; border: 0; padding: 3px; border-radius: 50%; cursor: pointer;
  background: conic-gradient(from 200deg, var(--c2, #ff3d77), var(--al, #ff3d77), var(--pl, #7c3aed), var(--c1, #1f3fae), var(--c2, #ff3d77)); transition: transform .15s var(--ease); }
.story-ring:hover { transform: scale(1.05); }
.story-ring .avatar { border: 3px solid var(--surface); box-sizing: content-box; }
.story-ring.seen { background: var(--border); }
.story-ring.add { background: transparent; }
.story-ring.add .avatar { border-color: transparent; }
.story-plus, .story-add-mini { position: absolute; right: 0; bottom: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--primary); color: var(--on-primary); display: grid; place-items: center; border: 2px solid var(--surface); }
.story-add-mini { right: 6px; top: 44px; bottom: auto; padding: 0; cursor: pointer; }
.story-name { font-size: 12px; color: var(--text-2); max-width: 76px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.story-viewer { position: fixed; inset: 0; z-index: 160; background: rgba(4, 6, 12, .96); display: grid; place-items: center; animation: fade-in .15s; }
.sv-frame { position: relative; width: min(420px, 100vw); height: min(760px, 100dvh); border-radius: 18px; overflow: hidden; background: #000; display: flex; flex-direction: column; }
@media (max-width: 480px) { .sv-frame { border-radius: 0; } }
.sv-bars { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; gap: 4px; z-index: 3; }
.sv-bar { flex: 1; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, .35); overflow: hidden; }
.sv-bar i { display: block; height: 100%; background: #fff; width: 0; }
.sv-head { position: absolute; top: 22px; left: 12px; right: 12px; z-index: 3; display: flex; align-items: center; gap: 10px; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.5); }
.sv-head b { display: block; font-size: 14px; }
.sv-head small { opacity: .8; font-size: 12px; }
.sv-light { color: #fff; }
.sv-light:hover { background: rgba(255,255,255,.15); color: #fff; }
.sv-stage { flex: 1; display: grid; place-items: center; position: relative; }
.sv-stage img { width: 100%; height: 100%; object-fit: contain; }
.sv-text { color: #fff; font-size: 26px; font-weight: 700; text-align: center; padding: 24px; line-height: 1.3; white-space: pre-wrap; overflow-wrap: anywhere; }
.sv-text.caption { position: absolute; left: 0; right: 0; bottom: 20px; font-size: 18px; background: linear-gradient(transparent, rgba(0,0,0,.6)); padding: 40px 20px 12px; }
.sv-nav { position: absolute; top: 70px; bottom: 80px; width: 35%; border: 0; background: transparent; z-index: 2; cursor: pointer; }
.sv-nav.prev { left: 0; } .sv-nav.next { right: 0; }
.sv-foot { position: relative; z-index: 3; padding: 10px 12px 14px; }
.sv-reply { display: flex; gap: 8px; }
.sv-reply .input { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.35); color: #fff; border-radius: 999px; }
.sv-reply .input::placeholder { color: rgba(255,255,255,.7); }
.sv-viewers { background: rgba(255,255,255,.15); color: #fff; }
.story-viewer .lb-close { position: absolute; top: 16px; right: 16px; }
.story-preview { position: relative; height: 340px; border-radius: 16px; overflow: hidden; display: grid; place-items: center; }
.story-preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
.story-text-input { position: relative; z-index: 1; width: 85%; background: transparent; border: 0; outline: none; resize: none; color: #fff; font-size: 24px; font-weight: 700; text-align: center; font-family: inherit; }
.story-text-input::placeholder { color: rgba(255,255,255,.75); }
.story-text-input.caption { align-self: end; font-size: 17px; background: rgba(0,0,0,.45); border-radius: 12px; padding: 8px; margin-bottom: 14px; }
.swatches { display: flex; gap: 6px; }
.swatch { width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--surface); box-shadow: 0 0 0 1px var(--border); cursor: pointer; padding: 0; }
.swatch[aria-checked="true"] { box-shadow: 0 0 0 2px var(--primary); }

.comm-avatar { border-radius: 14px !important; background: var(--primary-soft); color: var(--primary); font-weight: 800; }
.comm-avatar img { border-radius: 14px !important; }
.avatar.comm-avatar.big { border-radius: 26px !important; font-size: 44px; }
.avatar.comm-avatar.big img { border-radius: 22px !important; }
.profile-top .avatar.comm-avatar { border-radius: 26px !important; }
a.person.comm-row { color: var(--text); text-decoration: none; }
a.person.comm-row:hover { background: var(--surface-2); }
.comm-row .icon { color: var(--text-3); }
.pinned { border-color: color-mix(in srgb, var(--accent-bright) 45%, var(--border)); }
.pin-label { display: flex; gap: 6px; align-items: center; font-size: 12.5px; font-weight: 700; color: var(--accent); padding: 10px 16px 0; }

.group-avatar { background: linear-gradient(135deg, var(--primary), #7c3aed); color: #fff; }
.group-avatar .icon { width: 50%; height: 50%; }
.msg-system { align-self: center; font-size: 12.5px; color: var(--text-3); background: var(--surface); border: 1px dashed var(--border); border-radius: 999px; padding: 4px 12px; margin: 8px 0; text-align: center; max-width: 90%; }
.msg-sender { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--primary); margin: 10px 0 2px 4px; }
.link-btn { background: none; border: 0; padding: 0; font: inherit; font-weight: 700; color: var(--text); cursor: pointer; text-align: left; }
.link-btn:hover { text-decoration: underline; }
.chat-list-head.row { display: flex; }

.pick-list { max-height: 50vh; overflow-y: auto; display: flex; flex-direction: column; margin: 0 -8px; }
.pick-row { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 10px; cursor: pointer; }
.pick-row:hover { background: var(--surface-2); }
.pick-row input { width: 18px; height: 18px; accent-color: var(--primary); }
.circle-row { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; }

.date-badge { flex: none; width: 52px; border-radius: 12px; overflow: hidden; text-align: center; background: var(--surface); border: 1px solid var(--border); display: flex; flex-direction: column; }
.date-badge small { background: var(--accent); color: var(--on-accent); font-size: 11px; font-weight: 800; letter-spacing: .04em; padding: 2px 0; }
.date-badge b { font-size: 22px; padding: 2px 0 4px; color: var(--text); }
.date-badge.sm { width: 40px; border-radius: 9px; }
.date-badge.sm small { font-size: 9.5px; padding: 1px 0; }
.date-badge.sm b { font-size: 16px; padding: 1px 0 2px; }
.event-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
@media (min-width: 560px) { .event-grid { grid-template-columns: 1fr 1fr; } }
.event-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; color: var(--text); text-decoration: none !important; transition: box-shadow .15s, transform .15s var(--ease); }
.event-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
.event-cover { height: 120px; background: var(--surface-3); }
.event-cover img { width: 100%; height: 100%; object-fit: cover; }
.event-body { display: flex; gap: 12px; padding: 12px 14px 14px; }
.event-title { display: block; font-size: 15.5px; margin-bottom: 2px; }
.event-card .sub { font-size: 13px; color: var(--text-3); display: flex; align-items: center; gap: 2px; }
.event-card .status-pill { display: inline-block; margin-top: 6px; }
.status-pill.invite { background: var(--accent-soft); color: var(--accent); }
.event-hero { height: 180px; background: linear-gradient(120deg, var(--al, #d6246e) 0%, var(--pl, #5b3df5) 60%, var(--c1, #1f3fae) 120%); }
.event-h1 { font-size: 22px; margin-bottom: 4px; }
.event-main .text-2 { display: flex; align-items: center; gap: 4px; }
.rsvp button[aria-pressed="true"] { background: var(--primary); color: var(--on-primary); }
.person.is-new { background: color-mix(in srgb, var(--primary-soft) 60%, transparent); }
.status-pill .icon { width: 12px; height: 12px; vertical-align: -1px; }

@media (min-width: 720px) and (max-height: 860px) {
  .sidebar .nav a { padding-top: 7px; padding-bottom: 7px; }
  .sidebar { gap: 10px; }
}
@media (max-width: 719px) {
  .event-hero { height: 130px; }
  .story-item { width: 68px; }
}
.event-body { align-items: flex-start; }
.date-badge small { text-transform: uppercase; }
.msg-sender + .msg.first { margin-top: 0; }
.vis-select { max-width: 190px; text-overflow: ellipsis; }
@media (max-width: 719px) { .vis-select { max-width: 130px; } .composer .tools { flex-wrap: nowrap; } }
